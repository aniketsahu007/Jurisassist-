# Supabase PostgreSQL Connection String
# Find this in your Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Make sure to replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL="postgresql://postgres.xxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Temporary development identity while account handling is rebuilt
DEV_USER_ID="dev-user"
DEV_USER_EMAIL="dev@jurisassist.local"
DEV_USER_NAME="Development User"

# Supabase Storage (Project Settings -> API)
SUPABASE_URL="https://xxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Frontend Environment Variables (prefix with VITE_ so Vite exposes them)
VITE_API_URL="http://localhost:8000"
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
